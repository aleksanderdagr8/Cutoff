{
  "name": "@cutoff/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.ts --var CUTOFF_ENV:development",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "smoke:local": "vitest run src/smoke-local.test.ts"
  },
  "dependencies": {
    "@cutoff/adapters": "workspace:*",
    "@cutoff/contracts": "workspace:*",
    "@cutoff/db": "workspace:*",
    "@cutoff/domain": "workspace:*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.151.2"
  }
}
