{
  "name": "cutoff",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter @cutoff/domain --filter @cutoff/adapters --filter @cutoff/db --filter @cutoff/api --filter @cutoff/mcp --filter @cutoff/web run test && vitest run",
    "test:u0": "pnpm --filter @cutoff/api test && pnpm --filter @cutoff/db test && pnpm --filter @cutoff/domain test && pnpm --filter @cutoff/adapters test && pnpm --filter @cutoff/mcp test && pnpm --filter @cutoff/web test && vitest run && pnpm run check:boundaries",
    "test:u1": "pnpm --filter @cutoff/api test && pnpm --filter @cutoff/db test && pnpm --filter @cutoff/domain test && pnpm --filter @cutoff/mcp test && pnpm --filter @cutoff/web test && pnpm run check:boundaries",
    "test:phase1": "pnpm run test:u1",
    "test:phase2": "pnpm run test:u0",
    "test:phase3": "pnpm run test:u0",
    "test:phase4": "pnpm run test:u0",
    "test:phase5": "pnpm run test:u0",
    "test:phase6": "pnpm run test:u0",
    "test:phase7": "pnpm run test:u0",
    "test:phase8": "pnpm run test:u0",
    "test:phase9": "pnpm run test:u0",
    "test:phase10": "pnpm run test:u0",
    "test:phase11": "pnpm run test:u0",
    "test:phase12": "pnpm run test:u0",
    "test:phase13": "pnpm run test:u0",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "smoke:local": "pnpm --filter @cutoff/api run smoke:local",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm run check:boundaries"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
