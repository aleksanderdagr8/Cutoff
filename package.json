{
  "name": "cutoff",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter @cutoff/domain --filter @cutoff/adapters --filter @cutoff/db --filter @cutoff/api run test && vitest run",
    "test:u0": "pnpm --filter @cutoff/api test && pnpm --filter @cutoff/db test && pnpm --filter @cutoff/domain test && pnpm --filter @cutoff/adapters test && vitest run && pnpm run check:boundaries",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm run check:boundaries"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
