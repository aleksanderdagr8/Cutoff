# Documented for later units. Phase 0 tests use fakes and need none of these.
# When BOTH Supabase server vars are set, apps/api selects Postgres repos
# (createRepos / resolveReposModeFromEnv). Leave empty for memory (CI default).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE=

# Browser / Next.js household Auth (anon key only — never put service_role here).
# Same Project URL as SUPABASE_URL. Copy anon (or publishable) from
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics (gtag.js) — public Measurement ID. Defaults to production
# G-3K4P4MPMPD when unset. Set empty to disable locally. Must be present at
# Next build time for the client bundle (deploy-web.yml + wrangler vars).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-3K4P4MPMPD

STRIPE_SECRET_KEY=
CUTOFF_WEBHOOK_SECRET=
OPERATOR_EMAIL=

# Household address autocomplete (Google Places API New — server only).
# Enable Places API (New) on the GCP project. Restrict the key to
# places.googleapis.com. Set as Worker secret on cutoff-web (never NEXT_PUBLIC_).
# Until set, /home/mandate shows a disabled placeholder; mandate address_id still works.
GOOGLE_PLACES_API_KEY=

# Household /home Auth
# - Leave unset or 0 when NEXT_PUBLIC_SUPABASE_* are set → real Supabase Auth
#   (email + password). First sign-in calls ensure_home_member (links
#   auth.users.id → members.auth_user_id, creates household if needed).
# - Set 1 for local/CI demo cookie without Auth (escape hatch).
# - If NEXT_PUBLIC_SUPABASE_* are missing, bypass stays on automatically.
CUTOFF_HOME_DEV_BYPASS=

# Auth redirect allowlist (Supabase Dashboard → Authentication → URL configuration):
#   Site URL:          https://callcutoff.com   (local: http://localhost:3000)
#   Redirect URLs:     https://callcutoff.com/home/auth/callback
#                      http://localhost:3000/home/auth/callback
#
# Production Worker secrets (apps/web — never commit):
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
# Wrangler vars (committed defaults in apps/web/wrangler.jsonc):
#   CUTOFF_HOME_DEV_BYPASS=0  CUTOFF_OPS_DEV_BYPASS=1
#   NEXT_PUBLIC_GA_MEASUREMENT_ID=G-3K4P4MPMPD  (public; also set at build)
# Deploy: see apps/web/DEPLOY.md

# Operator /ops — local UI without live operator Auth + TOTP.
# Default: on when NEXT_PUBLIC_SUPABASE_* are unset. Set 0 only when live Auth is ready.
CUTOFF_OPS_DEV_BYPASS=1
